# Local AI via LM Studio (free, no key, no account).
# 1. Open LM Studio -> Developer tab -> Start Server
# 2. Load any instruct model
# 3. Leave the values below as they are
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=local-model
AI_API_KEY=

# Optional Supabase demo catalog. The anonymous key is read by the local server,
# not embedded in the browser bundle. With these blank, /api/catalog uses the
# matching local seeded catalog so the happy path always works.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never prefix this with VITE_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only n8n production webhook. Never expose the secret in Vite/client variables.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Random server-only value used to authorize browser polling for one generation job.
JOB_STATUS_SECRET=

# Optional in production. Defaults to the standard macOS Google Chrome path locally.
CHROME_PATH=

# To use a hosted provider instead, change AI_BASE_URL to its
# OpenAI-compatible endpoint and set AI_API_KEY.
